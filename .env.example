# Copia este archivo como .env y completa los valores reales.
# El .env NUNCA se commitea (fuente §12).

# Clave de API de OpenRouter
OPENROUTER_API_KEY=

# Modelo a usar vía OpenRouter (debe seguir instrucciones de JSON estricto)
OPENROUTER_MODEL=

# Base de datos Turso (libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secreto de firma de los JWT
JWT_SECRET=

# Entorno de ejecución (development | test | production)
NODE_ENV=development

# Puerto HTTP (Render lo asigna automáticamente)
PORT=3000
